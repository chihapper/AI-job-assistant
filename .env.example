# ---- Required for real AI calls (leave unset to run in mock mode) ----
ANTHROPIC_API_KEY=

# Force mock mode on (1) or off (0). Default: mock only when no API key is set.
# AI_MOCK=1

# Models. Opus for anything the user reads, Haiku for bulk extraction.
AI_MODEL_MAIN=claude-opus-5-5
AI_MODEL_FAST=claude-haiku-5-5

# Soft monthly spend warning in USD (0 = off)
MONTHLY_BUDGET_USD=25

# ---- Sign-in (single user) ----
# Required in production. In development, leaving it unset disables the sign-in gate.
APP_PASSWORD=
# Random string used to sign the session cookie. Derived from APP_PASSWORD if unset.
AUTH_SECRET=

# ---- Database ----
# Leave unset to use the embedded PGlite database under DATA_DIR (zero setup).
# Set to a Supabase Postgres connection string for hosted deployments.
DATABASE_URL=
DATA_DIR=./data

# ---- File storage ----
# local (default, under DATA_DIR/files) or supabase
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
